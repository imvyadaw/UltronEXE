# Copy this file to config/secrets.yaml and fill in real values.
# config/secrets.yaml must NEVER be committed - add it to .gitignore.
#
# This mirrors the .env-based secrets in .env.example; the .env file is
# still what config.py actually reads today. This template exists for the
# yaml-based config loader described in docs/architecture/configuration.md,
# for setups that prefer one secrets format instead of splitting between
# .env and yaml.

groq_api_key: ""              # https://console.groq.com/keys
telegram_bot_token: ""        # from @BotFather, only needed for plugins/installed/telegram

# Optional - only needed if the corresponding integration is enabled.
openai_api_key: ""
elevenlabs_api_key: ""
