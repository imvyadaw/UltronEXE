# ULTRON_FINAL_FIXED - environment variable template
# Copy this file to .env and fill in the values you actually use.
# Every value below is blank/placeholder - no real credentials are shipped
# in this file or anywhere else in the project (confirmed during audit).
# Leave anything you don't use blank - the codebase treats every one of
# these as optional and falls back to sane defaults when unset.

# ── App mode ──────────────────────────────────────────────
APP_ENV=development
AI_MODE=

# ── Cloud AI providers (used by ai/cloud_models/*) ──────────
GROQ_API_KEY=
GROQ_TIMEOUT=
GROQ_MAX_RETRIES=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
XKIRO_API_KEY=
XKIRO_BASE_URL=
XKIRO_MODEL=
OLLAMA_HOST=
OLLAMA_MODEL=
MODEL_RATE_LIMIT_COOLDOWN_SECONDS=90
FREE_MODEL_PRIORITY=
FAST_MODEL_NAME=
FAST_MODEL_TEMPERATURE=
FAST_MODEL_MAX_TOKENS=
FAST_MODEL_HISTORY_MESSAGES=

# ── Voice: speech-to-text / text-to-speech ──────────────────
STT_MODE=
STT_LANGUAGE=en
STT_LANGUAGE_SECONDARY=
WHISPER_LOCAL_MODEL=
TTS_ENGINE=
TTS_ENGINE_FALLBACK=
TTS_VOICE=
TTS_VOICE_HINDI=
PYTTSX_VOICE_HINT=
GTTS_LANG=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
WAKE_WORDS=
WAKE_WORD_ENGINE=
WAKE_WORD_MODELS=

# ── Vision / OCR ─────────────────────────────────────────────
VISION_MODEL_HOST=
VISION_MODEL_NAME=
TESSERACT_CMD=
ULTRON_CAMERA_SNAPSHOT_DIR=

# ── Email ────────────────────────────────────────────────────
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=
IMAP_HOST=
IMAP_PORT=

# ── Calendar / productivity integrations ────────────────────
GCAL_CREDENTIALS_PATH=
GCAL_TOKEN_PATH=
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=
NOTION_API_KEY=
OBSIDIAN_REST_API_KEY=
OBSIDIAN_REST_API_URL=
OBSIDIAN_VAULT_PATH=

# ── Messaging / social integrations ─────────────────────────
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TEAMS_WEBHOOK_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# ── Misc APIs ────────────────────────────────────────────────
TMDB_API_KEY=
TMDB_DEFAULT_COUNTRY=
YOUTUBE_API_KEY=
CAPTCHA_SOLVER_PROVIDER=
CAPTCHA_SOLVER_API_KEY=

# ── Storage / retrieval backends ─────────────────────────────
VECTOR_DB_BACKEND=

# ── Web UI / mobile API ───────────────────────────────────────
ULTRON_WEB_UI_HOST=127.0.0.1
ULTRON_WEB_UI_PORT=
ULTRON_WEB_UI_DEBUG=false
ULTRON_MOBILE_API_HOST=
ULTRON_MOBILE_API_PORT=
ULTRON_MOBILE_API_KEY=

# ── Feature flags (off by default; set to true/1 to enable) ──
ULTRON_AUTONOMY_ENABLED=false
ULTRON_AUTONOMOUS_WEB_ENABLED=false
ULTRON_ORCHESTRATOR_ENABLED=false
ULTRON_DEVICES_ENABLED=false
ULTRON_OFFLINE_KB_ENABLED=false
ULTRON_UI_ALLOW_STUB=false
ULTRON_LEARN_FROM_INTERNET=false
ULTRON_LEARN_INTERVAL_HOURS=6

# Financial intelligence - recurring stock/crypto price watcher (off by
# default; expense tracking + budgets always work, no gate needed).
ULTRON_MARKET_WATCH_ENABLED=false
ULTRON_MARKET_WATCH_INTERVAL_MINUTES=30
ULTRON_RUNTIME_SELF_PATCH_ENABLED=false

# ── Feature flags (core/assistant.py subsystems - were missing from
#    this file even though the code already reads them; defaults below
#    match what the code falls back to when the var is unset) ────────
ULTRON_MULTI_AGENT_SWARM_ENABLED=false
ULTRON_COGNITIVE_LAYER_ENABLED=false
ULTRON_ADVANCED_AUTONOMY_ENABLED=true
ULTRON_PROACTIVE_ENABLED=false
ULTRON_SPECIALIST_AGENTS_ENABLED=false
ULTRON_SKILL_CREATOR_ENABLED=false
ULTRON_ADAPTIVE_UI_ENABLED=false
ULTRON_VOICE_INTELLIGENCE_ENABLED=false
ULTRON_COMPUTER_VISION_ENABLED=false
ULTRON_CROSS_DEVICE_ENABLED=false
ULTRON_DEEP_OS_INTEGRATION_ENABLED=false
ULTRON_PREDICTIVE_ENGINE_ENABLED=false
ULTRON_QUANTUM_DASHBOARD_ENABLED=false
ULTRON_SELF_HEALING_ENABLED=false
ULTRON_SHIELD_ENABLED=false

# ── Tool-calling limits ───────────────────────────────────────
ULTRON_FULL_TOOL_SCHEMA=
ULTRON_MAX_TOOLS_PER_CALL=
ULTRON_WEAK_MATCH_FALLBACK_CAP=
